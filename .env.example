# Copie este arquivo para ".env" e preencha.

# ===== IAs =====
# O bot usa uma fila: cada tarefa tenta as IAs na ordem e, se uma falhar ou bater no limite, passa pra próxima.
# Só a primeira é necessária; cada chave a mais vira uma reserva. Todas têm plano grátis.

# Groq (principal: rápida, ótima pra conversa e a melhor pra transcrever áudio)
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (melhor pra ler foto e a única que lê PDF de comprovante; também entende áudio)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral (plano grátis "Experiment" com muitos tokens por mês; reserva pra texto e foto)
# https://console.mistral.ai
MISTRAL_API_KEY=

# OpenRouter (vários modelos grátis com uma chave; última reserva, só pra conversa)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modo privado: finanças, comprovantes e áudios vão só para a Groq (sem Gemini, Mistral e OpenRouter).
# Mais privacidade, mas sem leitura de PDF. Use "sim" para ligar.
IA_MODO_PRIVADO=nao

# Ordem das filas (opcional). Nomes: groq, gemini, mistral, openrouter.
# IA_FILA_TEXTO=groq,gemini,mistral,openrouter
# IA_FILA_FINANCAS=groq,gemini,mistral
# IA_FILA_IMAGEM=gemini,groq,mistral
# IA_FILA_PDF=gemini
# IA_FILA_AUDIO=groq,gemini

# Jeito de a IA responder (opcional). Padrão: assistente geral. Ex.: IA_PERSONALIDADE=você é um professor paciente.
# IA_PERSONALIDADE=
# Tamanho máximo da resposta (padrão 2048; até 8000). Valores maiores = respostas mais longas.
# IA_MAX_TOKENS=2048
# Quanto a IA de conversa "pensa" antes de responder: nenhum (mais rápido), baixo (padrão), medio ou alto.
# Pensar mais = resposta melhor, porém mais demorada. Lançar gastos e ler comprovantes nunca pensa.
# IA_RACIOCINIO=baixo

# Modelos (opcionais). Para ver os disponíveis: npm run modelos
# Se a Groq desligar um modelo que está aqui, o bot usa o substituto sozinho e avisa no log.
GROQ_MODELO=qwen/qwen3.8-27b
GROQ_MODELO_AUDIO=whisper-large-v3-turbo
# o qwen3.8 também lê imagens (o llama-4-scout foi desligado pela Groq em 17/07/2026)
GROQ_MODELO_VISAO=qwen/qwen3.8-27b
# o Gemini tenta na ordem: se o primeiro não existir, bater no limite ou estiver sobrecarregado, usa o segundo
GEMINI_MODELO=gemini-flash-latest,gemini-flash-lite-latest
MISTRAL_MODELO=mistral-small-latest
OPENROUTER_MODELO=openrouter/free

# Áudio mandado na conversa com você mesmo vira texto (e lançamento, se falar de dinheiro).
# Use "nao" para desligar.
AUDIO_AUTOMATICO=sim

# Seu número com DDI e DDD, só números (opcional).
# Se ficar vazio, o bot pergunta na hora de parear.
NUMERO_DONO=

# Quem mais pode usar o bot além de você (opcional).
# Números separados por vírgula (ex: 5511988887777,5521977776666) ou "todos".
# Vazio = só você. Também dá para liberar alguém pelo WhatsApp com #confiar [número].
PERMITIDOS=

# Cidade usada no #clima quando você não digita nenhuma (opcional).
CIDADE_PADRAO=

# Símbolo antes dos comandos (opcional).
PREFIXO=#

# Por quantos segundos, depois de um #s, fotos e vídeos viram figurinha sozinhos (opcional; 0 desliga).
SEGUNDOS_MODO_FIGURINHA=10

# Depuração (opcional): DEBUG_MSG=1 mostra no terminal uma linha para cada mensagem que chega
# (quem mandou, tipo, atraso e o começo do texto). Útil para descobrir se uma mensagem nem chegou ao bot.
# DEBUG_MSG=1
