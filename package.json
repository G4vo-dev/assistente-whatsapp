{
  "name": "assistente-whatsapp",
  "version": "1.0.0",
  "description": "Assistente pessoal para WhatsApp em Node.js: finanças com cartões e parcelas, IA com fila de provedores (Groq, Gemini, Mistral, OpenRouter), áudio e comprovantes, figurinhas, lembretes e avisos automáticos.",
  "author": "Zet (https://github.com/G4vo-dev)",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "nodejs",
    "ia",
    "groq",
    "gemini",
    "financas",
    "termux"
  ],
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "demo": "node scripts/demo.js",
    "iniciar": "sh scripts/iniciar.sh",
    "instalar-boot": "node scripts/instalar-boot.js",
    "log": "tail -n 60 -f dados/bot.log",
    "test": "node test/rodar.js",
    "lint": "eslint .",
    "modelos": "node scripts/listar-modelos.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.6",
    "groq-sdk": "^1.6.0",
    "pino": "^10.4.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
